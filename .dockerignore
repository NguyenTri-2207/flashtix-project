# Dependencies
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Build outputs (will be generated in container)
.next
out
dist
build
*.tsbuildinfo

# Environment files (should be injected at runtime via secrets/env vars)
# Note: .env.local is needed for Next.js build (NEXT_PUBLIC_* vars)
# But we prefer using build args in docker-compose.yml instead
.env
.env.development
.env.test
.env.production
# .env.local - Allow for local dev, but prefer build args for Docker

# Version control
.git
.gitignore
.gitattributes

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Testing
coverage
.nyc_output
*.test.js
*.test.ts
*.spec.js
*.spec.ts
__tests__
test
tests

# Documentation
*.md
docs
README.md
CHANGELOG.md
LICENSE

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS files
.DS_Store
Thumbs.db
*.pem

# Docker files (don't copy Dockerfiles into themselves)
Dockerfile*
docker-compose*.yml
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
.circleci

# Misc
*.zip
*.tar.gz
